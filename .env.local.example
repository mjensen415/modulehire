# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudflare Turnstile (bot check on signup) ───────────────────────────
# Create a site in the Cloudflare dashboard → Turnstile, then paste both keys.
# If TURNSTILE_SECRET_KEY is unset, the captcha is skipped (dev-friendly);
# once set in prod, signup tokens are enforced server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Email verification (P1.2) ────────────────────────────────────────────
# Master switch. When 'true', new signups are created UNCONFIRMED and must
# click an emailed link before they can generate resumes (they can still browse
# and build their library). Leave unset/false until the two prerequisites below
# are done, or new users will be unable to generate:
#   1. EMAIL_FROM must be a VERIFIED sender in Brevo (uses BREVO_API_KEY).
#   2. In Supabase → Authentication → Providers → Email, turn "Confirm email"
#      OFF, so unconfirmed users can still sign in and browse.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=
EMAIL_FROM_NAME=ModuleHire

# Cron
# Shared secret guarding /api/cron/purge. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Set the real value in Vercel env vars.
CRON_SECRET=

# ─── Stripe (ModuleHire 1.0) ──────────────────────────────────────────────
# Create these products in the Stripe dashboard, then paste the price IDs below.
# Products:
#   - Single resume     — $9 one-time          → STRIPE_PRICE_SINGLE_RESUME
#   - 5-pack            — $29 one-time         → STRIPE_PRICE_FIVE_PACK
#   - Pro Monthly       — $19/mo recurring     → STRIPE_PRICE_PRO_MONTHLY
#   - Pro Annual        — $99/yr recurring     → STRIPE_PRICE_PRO_ANNUAL
# Portal config: create a Customer Portal configuration in the dashboard
# (Settings → Billing → Customer portal) and paste its ID into STRIPE_PORTAL_CONFIG_ID.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=

STRIPE_PRICE_SINGLE_RESUME=
STRIPE_PRICE_FIVE_PACK=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
